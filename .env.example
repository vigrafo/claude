# ─────────────────────────────────────────────────────────────────────────────
# eropub.com – Umgebungsvariablen (Vorlage)
#
# Entwicklung:  cp .env.example .env            (Werte unten passen zu docker-compose.yml)
# Produktion:   cp .env.example .env.production && chmod 600 .env.production
#               ALLE mit "CHANGE_ME" markierten Werte ersetzen. Keine echten Secrets ins Git.
#
# Secrets erzeugen (Beispiele):
#   openssl rand -base64 48                     # SESSION_SECRET, Webhook-Secrets
#   openssl rand -base64 32                     # DATA_ENCRYPTION_KEY (exakt 32 Byte, base64)
#   openssl rand -hex 24                        # Passwörter für Postgres/Valkey/MinIO
# ─────────────────────────────────────────────────────────────────────────────

# ── Laufzeit ─────────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
# Öffentliche Basis-URL ohne abschließenden Slash (Links in E-Mails, Redirects).
# Produktion: https://eropub.com   Staging: https://eropub.de
APP_URL=http://localhost:3000

# ── Datenbank (PostgreSQL 16) ────────────────────────────────────────────────
# Entwicklung (docker-compose.yml):
DATABASE_URL=postgresql://eropub:eropub_dev@127.0.0.1:5432/eropub
# Produktion (Host "postgres" im Compose-Netz; Passwort = Inhalt von secrets/postgres_password):
# DATABASE_URL=postgresql://eropub:CHANGE_ME@postgres:5432/eropub?schema=public
# Optional, nur Integrationstests:
# TEST_DATABASE_URL=postgresql://eropub:eropub_dev@127.0.0.1:5432/eropub_ci

# ── Kryptografie ─────────────────────────────────────────────────────────────
# Signiert Sitzungen und pseudonymisiert IP-Hashes. Mind. 32 Zeichen Zufall.
# Wechsel macht alle Sitzungen ungültig.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Schlüssel für Feldverschlüsselung sensibler Daten: exakt 32 Byte, base64-kodiert.
#   openssl rand -base64 32
# ACHTUNG: Verlust = verschlüsselte Daten unlesbar. Getrennt vom Backup sicher verwahren
# (z. B. Passwortmanager + Offline-Kopie). Niemals nachträglich ändern ohne Re-Encryption.
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Sichtbarkeit / Sicherheit ────────────────────────────────────────────────
# false = /robots.txt sperrt alles. Zusätzlich setzt Caddy X-Robots-Tag (deploy/Caddyfile).
ALLOW_SEARCH_INDEXING=false
# Lokale Test-Adapter für Zahlung/Verifizierung. In Produktion MUSS dies false sein
# (zusätzlich technisch gesperrt, sobald APP_ENV=production).
ENABLE_TEST_ADAPTERS=true
# Optional: kommagetrennte IPs/Netze, die das Admin-Backend erreichen dürfen (leer = keine IP-Sperre).
# Beispiel: ADMIN_ALLOWED_IPS=203.0.113.10,2001:db8:1234::/48
ADMIN_ALLOWED_IPS=

# ── Redis / Valkey (Rate-Limits) ─────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
# Produktion (Passwort = Inhalt von secrets/valkey_password):
# REDIS_URL=redis://:CHANGE_ME@valkey:6379/0

# ── Objektspeicher für Fotos (privat) ─────────────────────────────────────────
# STORAGE_DRIVER: s3 (Produktion empfohlen) oder local (Entwicklung / Einzelserver, z. B. Plesk).
# Ohne Angabe: s3, wenn S3_ENDPOINT gesetzt ist, sonst local.
# STORAGE_DRIVER=local
# STORAGE_DIR=./storage            # nur für local – außerhalb von public/, mit Backup!
# S3_SSE=false                     # true = serverseitige Verschlüsselung anfordern (wenn vom Speicher unterstützt)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central-1
S3_BUCKET=eropub-media
S3_ACCESS_KEY=eropub-dev
S3_SECRET_KEY=eropub-dev-secret
# Produktion: eigener App-Benutzer (NICHT MinIO-Root), angelegt über den Dienst minio-init:
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=eropub-app
# S3_SECRET_KEY=CHANGE_ME

# ── LiveKit (Audio/Video) ────────────────────────────────────────────────────
# Leer lassen = Anrufe deaktiviert. Produktion: wss://rtc.eropub.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
# Produktion: openssl rand -base64 48 ; identisch in secrets/livekit_keys ("KEY: SECRET")
LIVEKIT_API_SECRET=
# Optional: öffentliche URL für Browser, falls abweichend (z. B. intern ws://livekit:7880, extern wss://rtc.eropub.com)
# LIVEKIT_PUBLIC_URL=wss://rtc.eropub.com
# Optional: interne API-URL für Raumverwaltung (Standard: LIVEKIT_URL)
# LIVEKIT_API_URL=http://livekit:7880
# Relay-Zwang (nur TURN) – verbirgt die IP-Adressen der Teilnehmenden voreinander. Standard: true.
# Lokal ohne TURN-Server auf false setzen.
CALLS_FORCE_RELAY=true

# ── E-Mail ───────────────────────────────────────────────────────────────────
# log  = nichts wird versendet (nur Log/Entwicklung)
# smtp = Versand über SMTP_* (Entwicklung: Mailpit auf 127.0.0.1:1025, UI http://127.0.0.1:8025)
MAIL_MODE=log
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true bei implizitem TLS (Port 465); false bei STARTTLS (587) oder Mailpit
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="eropub.com <info@eropub.com>"

# ── Zahlungen: CCBill (erst nach Vertrag; Aktivierung im Admin-Backend) ───────
CCBILL_CLIENT_ACCNUM=
CCBILL_CLIENT_SUBACC=
CCBILL_FLEXFORM_ID=
CCBILL_SALT=
# Kommagetrennte Absender-IPs/Netze laut aktueller CCBill-Dokumentation (Webhooks sind unsigniert).
CCBILL_WEBHOOK_IPS=

# ── Identitätsprüfung (Webhook-HMAC des Anbieters) ───────────────────────────
IDENTITY_WEBHOOK_SECRET=

# ── Nur Entwicklung/Test: HMAC für Test-Zahlungswebhooks ────────────────────
TEST_PAYMENT_WEBHOOK_SECRET=dev-only-test-webhook-secret
